DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
# Supabase only: pooled connection string used above (port 6543, ?pgbouncer=true) can't run migrations.
# Set DIRECT_URL to the direct connection (port 5432) for `prisma migrate` and pg_dump/pg_restore.
# For a plain single Postgres instance (local dev, Render), DIRECT_URL can just equal DATABASE_URL.
DIRECT_URL=postgresql://user:password@host:5432/dbname?schema=public
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
FRONTEND_URL=http://localhost:5173
# M-Pesa Paybill number, account-number format, and Buy Goods Till number are
# configured from the admin panel (Payment Settings), not env vars — customers
# pay manually and an admin confirms each payment against the M-Pesa statement.
PORT=4000

# Email (order receipts, verification, password reset) — configure SMTP or Brevo, or both.
# SMTP is tried first when set; Brevo is the fallback.
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=Movec Store
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Movec Store" <noreply@yourdomain.com>
CONTACT_EMAIL=info@yourdomain.com